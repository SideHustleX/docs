{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OneClickEZ",
  "description": "Help for OneClick EZ Shopify apps.",
  "colors": {
    "primary": "#7A39DD",
    "light": "#AD74FF",
    "dark": "#3F0082"
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "favicon": "/favicon.png",
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "products": [
      {
        "product": "All apps",
        "description": "OneClickEZ help",
        "icon": "house",
        "pages": [
          "index"
        ]
      },
      {
        "product": "Notify Me",
        "description": "Back in stock and price drop alerts",
        "icon": "bell",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "notify-me/index",
              "notify-me/install"
            ]
          },
          {
            "group": "Storefront",
            "pages": [
              "notify-me/enable-app-embed",
              "notify-me/widgets",
              "notify-me/back-in-stock-widget",
              "notify-me/price-drop-widget",
              "notify-me/popup"
            ]
          },
          {
            "group": "Alerts and email",
            "pages": [
              "notify-me/when-alerts-send",
              "notify-me/edit-alert-emails"
            ]
          },
          {
            "group": "Sending domain",
            "pages": [
              "notify-me/sending-domain",
              "notify-me/sending-domain/add-domain",
              "notify-me/sending-domain/dns-providers",
              "notify-me/sending-domain/de-150",
              "notify-me/sending-domain/deliverability"
            ]
          },
          {
            "group": "Customers",
            "pages": [
              "notify-me/subscribers"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "notify-me/integrations",
              "notify-me/integrations/klaviyo",
              "notify-me/integrations/mailchimp",
              "notify-me/integrations/omnisend",
              "notify-me/integrations/brevo"
            ]
          },
          {
            "group": "Settings",
            "pages": [
              "notify-me/settings"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "notify-me/troubleshooting",
              "notify-me/button-not-showing",
              "notify-me/emails-not-sending"
            ]
          }
        ]
      },
      {
        "product": "Wishlist",
        "description": "Wishlist and save for later",
        "icon": "heart",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "wishlist/index",
              "wishlist/install"
            ]
          }
        ]
      },
      {
        "product": "HustlePop",
        "description": "Email popup",
        "icon": "mail",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "hustlepop/index",
              "hustlepop/install"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "redirects": [
    {
      "source": "/notify-me/dns-providers",
      "destination": "/notify-me/sending-domain/dns-providers"
    },
    {
      "source": "/notify-me/deliverability",
      "destination": "/notify-me/sending-domain/deliverability"
    }
  ],
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  }
}
